LAKE_PATH=./data/lake
ADMIN_KEY=changeme
HOST=0.0.0.0
PORT=8080
MCP_PORT=8081
LOG_LEVEL=info
LOG_JSON=false

# 0 = all US stocks (mcap order). Set a cap on first deploys.
INGEST_MAX_TICKERS=0
INGEST_CONCURRENCY=6
SEED_SESSIONS=14
OPEN_WINDOW_MINUTES=5
HTTP_TIMEOUT_S=30

# Optional: sync parquet to MinIO after each successful session
# MINIO_ENDPOINT=http://minio:9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=paper-broker
# MINIO_SECURE=false

# Supabase Postgres (Coolify internal hostname). Empty = skip SQL migrations.
# DATABASE_URL=postgresql://postgres:PASSWORD@supabase-db:5432/postgres

# Frontend (Vite). Comma-separated. Use * only on a private network.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://paper-broker.oppenheimer.studio
WEB_DIST=./web/dist
