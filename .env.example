LAKE_PATH=./data/lake
ADMIN_KEY=changeme
HOST=0.0.0.0
PORT=8080
MCP_PORT=8081
LOG_LEVEL=info
LOG_JSON=false

# 0 = all US stocks (mcap order). Set a cap on first deploys.
INGEST_MAX_TICKERS=0
INGEST_CONCURRENCY=6
SEED_SESSIONS=14
OPEN_WINDOW_MINUTES=5
HTTP_TIMEOUT_S=30

